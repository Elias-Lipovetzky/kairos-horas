POSTGRES_DB=kairos
POSTGRES_USER=kairos
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://kairos:replace-with-a-long-random-password@localhost:5432/kairos
PORT=3000
APP_PORT=8080
APP_BIND_ADDRESS=0.0.0.0
APP_URL=http://localhost:8080
COOKIE_SECURE=false
SESSION_HOURS=12
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Production HTTPS: run scripts/enable-https.sh on the server.
# It preserves database credentials and sets APP_URL, COOKIE_SECURE,
# COMPOSE_PROJECT_NAME, COMPOSE_FILE and NGINX_CONFIG after verification.
